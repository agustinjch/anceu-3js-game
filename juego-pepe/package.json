{
  "name": "pepe-pegadas-anceu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "assets:pepe": "gltf-transform optimize \"assets/glb pepe.glb\" public/models/pepe.glb --compress meshopt --texture-compress webp --texture-size 1024"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
